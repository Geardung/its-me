---
import type { TimelineEntry } from "../data/profile";
import SectionHeading from "./SectionHeading.astro";
import Telemoji from "./Telemoji.astro";

interface Props {
  entries: TimelineEntry[];
}

const { entries } = Astro.props;
---

<section id="timeline" class="section">
  <SectionHeading
    eyebrow="history://engineering"
    title="Таймлайн развития"
    description="Не календарь должностей, а карта того, как формировалось инженерное мышление: от отдельных задач к системному взгляду."
    emoji={entries[0].emoji}
  />

  <div class="timeline">
    {
      entries.map((entry) => (
        <article class="panel timeline-card">
          <div class="timeline-card__period">{entry.period}</div>

          <div class="timeline-card__content">
            <div class="timeline-card__heading">
              <div>
                <h3>{entry.title}</h3>
                <p>{entry.description}</p>
              </div>

              <Telemoji asset={entry.emoji} size={54} />
            </div>

            <ul>
              {
                entry.outcomes.map((outcome) => (
                  <li>{outcome}</li>
                ))
              }
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .timeline {
    display: grid;
    gap: 1rem;
  }

  .timeline-card {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1.2rem;
    padding: 1.4rem;
  }

  .timeline-card__period {
    display: inline-flex;
    align-items: start;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .timeline-card__content {
    display: grid;
    gap: 1rem;
    padding-left: 1.2rem;
    border-left: 1px solid rgba(108, 70, 29, 0.22);
  }

  .timeline-card__heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  h3,
  p {
    margin: 0;
  }

  h3 {
    font-size: 1.45rem;
    margin-bottom: 0.55rem;
  }

  p,
  li {
    color: var(--color-text-soft);
    line-height: 1.75;
  }

  ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding-left: 1rem;
  }

  @media (max-width: 820px) {
    .timeline-card {
      grid-template-columns: 1fr;
    }

    .timeline-card__content {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
