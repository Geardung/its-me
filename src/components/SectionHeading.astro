---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  id?: string;
}

const { eyebrow, title, description, id } = Astro.props;
---

<div class="section-heading">
  <div class="section-heading__eyebrow">
    <span>{eyebrow}</span>
  </div>

  <h2 class="section-heading__title">
    {id && (
      <a href={`#${id}`} class="section-heading__anchor" aria-label={`Ссылка на раздел: ${title}`}>#</a>
    )}
    {title}
  </h2>
  <p>{description}</p>
</div>

<style>
  .section-heading {
    display: grid;
    gap: 0.9rem;
    max-width: 48rem;
  }

  .section-heading__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2,
  .section-heading__title {
    position: relative;
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
  }

  .section-heading__anchor {
    position: absolute;
    right: 100%;
    margin-right: 0.5rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.5em;
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.2s;
    line-height: 1;
  }

  .section-heading__title:hover .section-heading__anchor,
  .section-heading__anchor:hover {
    opacity: 1;
  }

  p {
    margin: 0;
    color: var(--color-text-soft);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  @media (max-width: 760px) {
    .section-heading {
      gap: 0.7rem;
    }

    .section-heading__eyebrow {
      font-size: 0.78rem;
      letter-spacing: 0.1em;
    }

    .section-heading__anchor {
      display: none;
    }

    p {
      font-size: 0.98rem;
      line-height: 1.6;
    }
  }
</style>
