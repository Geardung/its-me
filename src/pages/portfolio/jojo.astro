---
import BaseLayout from "../../layouts/BaseLayout.astro";

const annotations = [
  {
    id: "hero",
    title: "Hero-секция",
    text: "Фоновое изображение взято из Яндекс Карт — быстро и по делу. Градиент поверх даёт нужный контраст для текста.",
  },
  {
    id: "menu",
    title: "Интерактивное меню",
    text: "Меню сделано с hover-эффектами и ценниками в моноширинном шрифте — выглядит стильно и легко читается.",
  },
  {
    id: "reviews",
    title: "Карусель отзывов",
    text: "Отзывы взяты из Яндекс Карт и 2GIS. 3D-карусель с поворотом — необычно, но работает на всех устройствах.",
  },
  {
    id: "gallery",
    title: "Галерея",
    text: "Фото загружаются лениво (lazy loading), первая экран не тормозит. Masonry-раскладка через CSS Grid.",
  },
];
---

<BaseLayout
  title="Jojo — Портфолио | Alexander Tedeshi"
  description="Кальян-бар в Казани — сайт создан с нуля за час"
  siteName="Alexander Tedeshi"
  locale="ru_RU"
  ogImageAlt="Jojo — Кальян-бар в Казани"
  brand="Alexander Tedeshi"
  role="Full-stack Developer"
  navItems={[]}
>
  <div class="portfolio-work">
    <aside class="portfolio-work__sidebar">
      <a href="/#portfolio" class="portfolio-work__back">← Назад к портфолио</a>

      <div class="portfolio-work__header">
        <h1>Jojo — Кальян-бар</h1>
        <p>Сайт создан с нуля за час для кальян-бара в Казани</p>
      </div>

      <div class="portfolio-work__meta">
        <div class="portfolio-work__meta-item">
          <span class="portfolio-work__label">Тип</span>
          <span>Лендинг</span>
        </div>
        <div class="portfolio-work__meta-item">
          <span class="portfolio-work__label">Время</span>
          <span>1 час</span>
        </div>
        <div class="portfolio-work__meta-item">
          <span class="portfolio-work__label">Стек</span>
          <span>HTML, CSS, JS</span>
        </div>
      </div>

      <div class="portfolio-work__description">
        <p>Одностраничный сайт для кальян-бара Jojo в Казани. Включает hero-секцию, блок «О нас» со статистикой, интерактивное меню, галерею, карусель отзывов и контактную информацию с картой.</p>
      </div>

      <div class="portfolio-work__annotations-toggle">
        <button id="toggleAnnotations" class="portfolio-work__btn">
          <span class="portfolio-work__btn-icon">💬</span>
          Комментарии автора
        </button>
        <button id="openClean" class="portfolio-work__btn portfolio-work__btn--secondary">
          Чистый просмотр →
        </button>
      </div>

      <div class="portfolio-work__annotations" id="annotations">
        <p class="portfolio-work__annotations-title">Заметки по проекту</p>
        {
          annotations.map((a) => (
            <div class="portfolio-work__annotation" data-target={a.id}>
              <strong>{a.title}</strong>
              <span>{a.text}</span>
            </div>
          ))
        }
      </div>
    </aside>

    <main class="portfolio-work__preview">
      <div class="portfolio-work__browser">
        <div class="portfolio-work__browser-dots">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="portfolio-work__browser-url">jojo-site</div>
      </div>
      <div class="portfolio-work__frame">
        <iframe
          src="/portfolio/jojo/site/index.html"
          title="Jojo Website Preview"
          loading="lazy"
          id="siteFrame"
        ></iframe>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  :global(.page-content) {
    padding: 0 !important;
    gap: 0 !important;
    width: 100% !important;
    max-width: none !important;
  }

  :global(.topbar) {
    display: none !important;
  }

  :global(.footer) {
    display: none !important;
  }

  .portfolio-work {
    display: grid;
    grid-template-columns: 14rem 1fr;
    height: 100dvh;
    overflow: hidden;
  }

  .portfolio-work__sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.2rem;
    border-right: 1px solid var(--color-border);
    background: var(--color-panel);
    overflow-y: auto;
    min-height: 0;
  }

  .portfolio-work__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .portfolio-work__back:hover {
    opacity: 0.7;
  }

  .portfolio-work__header h1 {
    margin: 0 0 0.3rem;
    font-size: 1.3rem;
    line-height: 1.2;
  }

  .portfolio-work__header p {
    margin: 0;
    color: var(--color-text-soft);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .portfolio-work__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    background: var(--color-panel-soft);
  }

  .portfolio-work__meta-item {
    display: grid;
    gap: 0.2rem;
  }

  .portfolio-work__label {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .portfolio-work__description p {
    margin: 0;
    color: var(--color-text-soft);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .portfolio-work__annotations-toggle {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .portfolio-work__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-accent);
    border-radius: 0.5rem;
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .portfolio-work__btn:hover {
    opacity: 0.85;
  }

  .portfolio-work__btn--secondary {
    background: transparent;
    color: var(--color-accent);
  }

  .portfolio-work__btn-icon {
    font-size: 1rem;
  }

  .portfolio-work__annotations {
    display: none;
    flex-direction: column;
    gap: 0.8rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border);
  }

  .portfolio-work__annotations.visible {
    display: flex;
  }

  .portfolio-work__annotations-title {
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .portfolio-work__annotation {
    display: grid;
    gap: 0.3rem;
    padding: 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    background: var(--color-panel-soft);
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .portfolio-work__annotation:hover {
    border-color: var(--color-accent);
  }

  .portfolio-work__annotation.active {
    border-color: var(--color-accent);
    background: rgba(108, 70, 29, 0.08);
  }

  .portfolio-work__annotation strong {
    margin: 0;
    font-size: 0.82rem;
  }

  .portfolio-work__annotation span {
    margin: 0;
    color: var(--color-text-soft);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .portfolio-work__preview {
    display: flex;
    flex-direction: column;
    height: 100vh;
    background: #1a1a2e;
  }

  .portfolio-work__browser {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(0, 0, 0, 0.3);
  }

  .portfolio-work__browser-dots {
    display: flex;
    gap: 0.35rem;
  }

  .portfolio-work__browser-dots span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
  }

  .portfolio-work__browser-url {
    flex: 1;
    padding: 0.35rem 0.7rem;
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.5);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .portfolio-work__frame {
    position: relative;
    flex: 1;
    overflow: hidden;
  }

  .portfolio-work__frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 900px) {
    .portfolio-work {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      height: auto;
      min-height: 100dvh;
    }

    .portfolio-work__sidebar {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
      max-height: none;
      overflow-y: visible;
    }

    .portfolio-work__preview {
      height: 70vh;
      min-height: 400px;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById("toggleAnnotations");
  const annotationsPanel = document.getElementById("annotations");
  const annotationsList = document.querySelectorAll(".portfolio-work__annotation");
  let annotationsVisible = false;

  toggleBtn?.addEventListener("click", () => {
    annotationsVisible = !annotationsVisible;
    annotationsPanel?.classList.toggle("visible", annotationsVisible);
    toggleBtn.textContent = annotationsVisible ? "Скрыть комментарии" : "Комментарии автора";
  });

  annotationsList.forEach((item) => {
    item.addEventListener("click", () => {
      item.classList.toggle("active");
    });
  });

  document.getElementById("openClean")?.addEventListener("click", () => {
    window.open("/portfolio/jojo/site/index.html", "_blank");
  });
</script>
